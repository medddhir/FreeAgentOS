#!/usr/bin/env python3
"""Launch only the authoritative FreeAgentOS production graph CLI."""

import os
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
PYTHON = ROOT / ".venv-orchestrator" / "bin" / "python3"
CLI = ROOT / "orchestrator" / "cli.py"

if not PYTHON.is_file() or not CLI.is_file():
    print("STATUS=CONTROLLER_ERROR\nBLOCK_REASON=PRODUCTION_RUNTIME_UNAVAILABLE", file=sys.stderr)
    sys.exit(4)

os.execv(str(PYTHON), [str(PYTHON), str(CLI), *sys.argv[1:]])
